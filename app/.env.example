# Copy this file to app/.env. Never commit app/.env.
# Address of the NoWaste API (npm run dev:server). On a real phone with Expo Go, "localhost" is the phone itself,
# so use your laptop's Wi-Fi IP address instead (run `ipconfig` on Windows, look for "IPv4 Address").
# The phone and the laptop must be on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
